rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email == 'victoriouschepchirchir59@gmail.com' ||
         request.auth.token.email == 'admin@agrima.co.ke' ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Produce listings: anyone can browse active produce; farmers manage their own; admins manage all
    match /produce/{produceId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid || 
        resource.data.farmerId == request.auth.token.email || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid || 
        resource.data.farmerId == request.auth.token.email || 
        isAdmin()
      );
    }

    // Orders: buyer, farmer, and admin have access
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.buyerEmail == request.auth.token.email ||
        resource.data.farmerPhone == request.auth.token.phone_number ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Negotiations
    match /negotiations/{negotiationId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Market Prices benchmark: readable by all, writeable by authenticated users & admins
    match /marketPrices/{priceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }

    // Messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Disputes
    match /disputes/{disputeId} {
      allow read, write: if isAuthenticated();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
